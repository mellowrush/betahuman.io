---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionDivider from '../components/SectionDivider.astro';
import Hero from '../components/sections/Hero.astro';
import Signal from '../components/sections/Signal.astro';
import Notes from '../components/sections/Notes.astro';
import Builds from '../components/sections/Builds.astro';
import About from '../components/sections/About.astro';
---

<Base>
  <div class="page">
    <Header />

    <main id="main-content">
      <Hero />
      <SectionDivider label="What this is" />
      <Signal />
      <SectionDivider label="Field notes" />
      <Notes />
      <SectionDivider label="Builds" />
      <Builds />
      <SectionDivider label="About" />
      <About />
    </main>

    <Footer />
  </div>
</Base>

<style>
  .page {
    max-width: var(--bh-container-narrow);
    margin-inline: auto;
    padding: var(--bh-space-8) var(--bh-space-5) var(--bh-space-10);
  }
</style>
