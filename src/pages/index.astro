---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes')).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);
---

<Base>
  <div class="page">
    <Header />

    <main id="main-content">

      <!-- HERO -->
      <section class="hero">
        <div class="hero-version">v0.1 · Brussels · 2026</div>
        <h1 class="hero-headline">
          Navigating technology,<br />
          complexity, and <em>becoming.</em>
        </h1>
        <p class="hero-lead">
          A senior frontend developer somewhere between who he ended up as
          and who he's choosing to become. This is the map room.
        </p>
        <blockquote class="hero-manifesto">
          Not finished. Not final. Still becoming.
        </blockquote>
      </section>

      <!-- DIVIDER -->
      <div class="divider">
        <div class="divider-line"></div>
        <span class="divider-mark">What this is</span>
        <div class="divider-line"></div>
      </div>

      <!-- SIGNAL -->
      <section>
        <p class="signal-intro">
          This is not a portfolio. Not a thought-leadership platform.
          A digital home for someone who investigates, questions,
          and searches for better systems — and documents the process honestly.
        </p>
        <ul class="signal-list">
          <li>Tools built at the intersection of genuine utility and craft</li>
          <li>Field notes from navigating technology and modern work</li>
          <li>First-principles thinking, shown not declared</li>
          <li>Questions held open, not packaged as answers</li>
          <li>The creative and the technical, treated as one thing</li>
        </ul>
      </section>

      <!-- DIVIDER -->
      <div class="divider">
        <div class="divider-line"></div>
        <span class="divider-mark">Field notes</span>
        <div class="divider-line"></div>
      </div>

      <!-- NOTES -->
      <section id="notes">
        <nav class="notes-list" aria-label="Field notes">
          {notes.map((note) => (
            <a class="note-entry" href={`/notes/${note.slug}`}>
              <span class="note-date">{note.data.date}</span>
              <span class="note-title">{note.data.title}</span>
              <span class="note-tag">{note.data.category}</span>
            </a>
          ))}
        </nav>
      </section>

      <!-- DIVIDER -->
      <div class="divider">
        <div class="divider-line"></div>
        <span class="divider-mark">Builds</span>
        <div class="divider-line"></div>
      </div>

      <!-- BUILDS — articles, not links: projects not yet live -->
      <section id="builds">
        <div class="builds-grid">
          <article class="build-card" data-status="active">
            <div class="build-card-status">In progress</div>
            <div class="build-card-title">QR Artifier</div>
            <div class="build-card-desc">
              Turn functional QR codes into deliberate visual artifacts.
              Utility elevated by craft.
            </div>
          </article>
          <article class="build-card">
            <div class="build-card-status">Exploring</div>
            <div class="build-card-title">Resume as SVG</div>
            <div class="build-card-desc">
              A résumé generator that produces art, not documents.
              Client-side, no server needed.
            </div>
          </article>
          <article class="build-card">
            <div class="build-card-status">Concept</div>
            <div class="build-card-title">Font Pairing Lab</div>
            <div class="build-card-desc">
              Live component previews for typographic combinations.
              See it in context, not a specimen.
            </div>
          </article>
          <article class="build-card">
            <div class="build-card-status">Concept</div>
            <div class="build-card-title">Palette Extractor</div>
            <div class="build-card-desc">
              Color palette extraction built for developers, not designers.
              Copy-ready output.
            </div>
          </article>
        </div>
      </section>

      <!-- DIVIDER -->
      <div class="divider">
        <div class="divider-line"></div>
        <span class="divider-mark">About</span>
        <div class="divider-line"></div>
      </div>

      <!-- ABOUT -->
      <section id="about">
        <p class="signal-intro">
          Senior frontend developer. Self-taught. Background in creative and advertising work.
          Based in Brussels. Currently rebuilding — not from wreckage, but from the quiet
          realisation that the life you end up with isn't always the one you consciously chose.
        </p>
        <div class="about-grid">
          <div class="about-block">
            <h3>What I do</h3>
            <p>Build interfaces with JavaScript and React. Care about the gap between
            functional and beautiful. Treat low complexity as a feature, not a limitation.</p>
          </div>
          <div class="about-block">
            <h3>How I think</h3>
            <p>In frameworks and reference points. I anchor new ideas to exemplars,
            reverse-engineer the principles, then generate variations. First principles
            over trends, always.</p>
          </div>
          <div class="about-block">
            <h3>What I reject</h3>
            <p>Generic advice. Corporate nonsense. Empty authority. Performative expertise.
            Trendy content that forgets to be useful.</p>
          </div>
          <div class="about-block">
            <h3>What this version is</h3>
            <p>v0.1. A working title. The beta is real, not ironic.
            This site will change as I do. That's the point.</p>
          </div>
        </div>
      </section>

    </main>

    <Footer />
  </div>
</Base>

<style>
  .page {
    max-width: var(--bh-container-narrow);
    margin-inline: auto;
    padding: var(--bh-space-8) var(--bh-space-5) var(--bh-space-10);
  }

  /* HERO */
  .hero { margin-bottom: var(--bh-space-8); }

  .hero-version {
    font-family: var(--bh-font-mono);
    font-size: var(--bh-text-xs);
    letter-spacing: var(--bh-tracking-mono);
    text-transform: uppercase;
    color: var(--bh-text-faint);
    margin-bottom: var(--bh-space-5);
    display: flex;
    align-items: center;
    gap: var(--bh-space-3);
  }

  .hero-version::before {
    content: '';
    display: block;
    width: 20px;
    height: 1px;
    background: var(--bh-text-faint);
  }

  .hero-headline {
    font-family: var(--bh-font-display);
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    line-height: var(--bh-leading-tight);
    letter-spacing: var(--bh-tracking-tight);
    color: var(--bh-text);
    margin-bottom: var(--bh-space-5);
    text-wrap: balance;
  }

  .hero-headline em {
    color: var(--bh-rust);
    font-style: italic;
  }

  .hero-lead {
    font-size: var(--bh-text-md);
    line-height: var(--bh-leading-normal);
    color: var(--bh-text-muted);
    max-width: 38ch;
    margin-bottom: var(--bh-space-6);
    text-wrap: pretty;
  }

  /* No side-stripe. Italic display type carries the distinction. */
  .hero-manifesto {
    display: block;
    font-family: var(--bh-font-display);
    font-style: italic;
    font-size: var(--bh-text-md);
    color: var(--bh-text-muted);
    line-height: var(--bh-leading-snug);
    margin: 0;
  }

  /* DIVIDER */
  .divider {
    display: flex;
    align-items: center;
    gap: var(--bh-space-4);
    margin: var(--bh-space-9) 0;
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: var(--bh-border-strong);
  }

  .divider-mark {
    font-family: var(--bh-font-mono);
    font-size: var(--bh-text-xs);
    letter-spacing: var(--bh-tracking-mono);
    text-transform: uppercase;
    color: var(--bh-text-faint);
  }

  /* SIGNAL */
  .signal-intro {
    font-size: var(--bh-text-base);
    line-height: var(--bh-leading-normal);
    color: var(--bh-text-muted);
    margin-bottom: var(--bh-space-6);
    text-wrap: pretty;
  }

  .signal-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--bh-space-3);
  }

  .signal-list li {
    display: flex;
    align-items: baseline;
    gap: var(--bh-space-3);
    font-size: var(--bh-text-sm);
    color: var(--bh-text);
  }

  .signal-list li::before {
    content: '→';
    font-family: var(--bh-font-mono);
    font-size: var(--bh-text-xs);
    color: var(--bh-text-faint);
    flex-shrink: 0;
  }

  /* NOTES LIST */
  .notes-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--bh-border);
    border: 1px solid var(--bh-border-strong);
    border-radius: var(--bh-radius-md);
    overflow: hidden;
  }

  .note-entry {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    gap: var(--bh-space-4) var(--bh-space-5);
    align-items: baseline;
    padding: var(--bh-space-4) var(--bh-space-5);
    background: var(--bh-bg);
    border-bottom: none;
    color: var(--bh-text);
    transition: background var(--bh-duration-fast) var(--bh-ease);
  }

  .note-entry:hover {
    background: var(--bh-rust-light);
    color: var(--bh-ink);
  }

  .note-date {
    font-family: var(--bh-font-mono);
    font-size: var(--bh-text-xs);
    color: var(--bh-text-faint);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .note-title {
    font-size: var(--bh-text-sm);
    font-weight: 500;
    color: var(--bh-text);
    line-height: var(--bh-leading-snug);
  }

  .note-entry:hover .note-title,
  .note-entry:hover .note-date,
  .note-entry:hover .note-tag { color: var(--bh-ink); }

  /* Dark mode: rust-light (#f0ddd6) on ink is jarring — use a lifted surface instead */
  :global([data-theme="dark"]) .note-entry:hover {
    background: var(--bh-bg-elevated);
    color: var(--bh-text);
  }

  :global([data-theme="dark"]) .note-entry:hover .note-title,
  :global([data-theme="dark"]) .note-entry:hover .note-date,
  :global([data-theme="dark"]) .note-entry:hover .note-tag {
    color: var(--bh-text);
  }

  .note-tag {
    font-family: var(--bh-font-mono);
    font-size: var(--bh-text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bh-text-faint);
    white-space: nowrap;
  }

  /* BUILDS — theme-aware: ink surface on light, paper surface on dark */
  .builds-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--bh-space-3);
  }

  .build-card {
    background: var(--bh-bg-inverse);
    border-radius: var(--bh-radius-md);
    padding: var(--bh-space-5);
  }

  /* Status: quiet by default; rust marks the one active build */
  .build-card-status {
    font-family: var(--bh-font-mono);
    font-size: var(--bh-text-xs);
    letter-spacing: var(--bh-tracking-mono);
    text-transform: uppercase;
    color: var(--bh-text-inverse);
    opacity: 0.45;
    margin-bottom: var(--bh-space-3);
  }

  .build-card[data-status="active"] .build-card-status {
    color: var(--bh-rust);
    opacity: 1;
  }

  .build-card-title {
    font-family: var(--bh-font-sans);
    font-size: var(--bh-text-base);
    font-weight: 700;
    color: var(--bh-text-inverse);
    line-height: var(--bh-leading-snug);
    margin-bottom: var(--bh-space-2);
  }

  .build-card-desc {
    font-size: var(--bh-text-xs);
    color: var(--bh-text-inverse);
    line-height: var(--bh-leading-normal);
    opacity: 0.6;
  }

  /* ABOUT */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--bh-space-6) var(--bh-space-8);
    margin-top: var(--bh-space-6);
  }

  .about-block h3 {
    font-family: var(--bh-font-sans);
    font-size: var(--bh-text-sm);
    font-weight: 700;
    color: var(--bh-text);
    margin-bottom: var(--bh-space-2);
    letter-spacing: -0.01em;
  }

  .about-block p {
    font-size: var(--bh-text-sm);
    line-height: var(--bh-leading-normal);
    color: var(--bh-text-muted);
    text-wrap: pretty;
  }

  /* RESPONSIVE */
  @media (max-width: 600px) {
    .about-grid  { grid-template-columns: 1fr; }
    .builds-grid { grid-template-columns: 1fr; }

    .note-entry {
      grid-template-columns: 1fr;
      gap: var(--bh-space-1);
    }
    .note-tag { display: none; }
  }
</style>
