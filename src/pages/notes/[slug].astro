---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await note.render();
---

<Base title={`${note.data.title} — betahuman.io`}>
  <div class="page">

    <header class="note-header">
      <a href="/#notes" class="back-link">← Notes</a>
      <div class="note-meta">
        <span class="note-meta__date">{note.data.date}</span>
        <span class="note-meta__sep">·</span>
        <span class="note-meta__category">{note.data.category}</span>
      </div>
    </header>

    <main id="main-content">
    <article class="note-article">
      <h1 class="note-title">{note.data.title}</h1>
      <div class="note-body">
        <Content />
      </div>
    </article>

    <footer class="note-footer">
      <a href="/#notes" class="back-link">← All notes</a>
    </footer>
    </main>

  </div>
</Base>

<style>
  .page {
    max-width: var(--bh-container-narrow);
    margin-inline: auto;
    padding: var(--bh-space-8) var(--bh-space-5) var(--bh-space-10);
  }

  .note-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--bh-space-9);
    padding-bottom: var(--bh-space-5);
    border-bottom: 1px solid var(--bh-border);
  }

  .back-link {
    font-family: var(--bh-font-mono);
    font-size: var(--bh-text-xs);
    letter-spacing: var(--bh-tracking-mono);
    text-transform: uppercase;
    color: var(--bh-text-faint);
    border-bottom: none;
    transition: color var(--bh-duration-base) var(--bh-ease);
  }

  .back-link:hover { color: var(--bh-rust); }

  .note-meta {
    display: flex;
    gap: var(--bh-space-2);
    font-family: var(--bh-font-mono);
    font-size: var(--bh-text-xs);
    letter-spacing: var(--bh-tracking-mono);
    text-transform: uppercase;
    color: var(--bh-text-faint);
  }

  .note-title {
    font-family: var(--bh-font-display);
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    font-weight: 400;
    letter-spacing: var(--bh-tracking-tight);
    line-height: var(--bh-leading-snug);
    color: var(--bh-text);
    margin-bottom: var(--bh-space-8);
  }

  .note-body {
    font-size: var(--bh-text-md);
    line-height: var(--bh-leading-normal);
    color: var(--bh-text-muted);
  }

  .note-body p {
    margin-bottom: var(--bh-space-5);
  }

  .note-body p:last-child {
    margin-bottom: 0;
  }

  .note-footer {
    margin-top: var(--bh-space-9);
    padding-top: var(--bh-space-5);
    border-top: 1px solid var(--bh-border);
  }

  /* ── Page entrance ──────────────────────────────────────────────────────── */

  @keyframes article-enter {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .note-header {
    animation: article-enter 350ms cubic-bezier(0.22, 0.61, 0.36, 1) 0ms backwards;
  }

  .note-article {
    animation: article-enter 450ms cubic-bezier(0.22, 0.61, 0.36, 1) 80ms backwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .note-header, .note-article {
      animation: none !important;
    }
  }
</style>
