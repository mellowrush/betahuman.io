---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);

function formatDate(raw: string): string {
  const parts = raw.split('-');
  if (parts.length < 2) return raw;
  const year = parseInt(parts[0]);
  const month = parseInt(parts[1]) - 1;
  const day = parts.length > 2 ? parseInt(parts[2]) : undefined;
  const d = new Date(year, month, day ?? 1);
  return day
    ? d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
    : d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
}
---

<Base title={`${note.data.title} — betahuman.io`} description={note.data.description}>
  <div class="page">

    <header class="note-header">
      <a href="/#notes" class="back-link">← Notes</a>
      <div class="note-meta">
        <span class="note-meta__date">{formatDate(note.data.date)}</span>
        <span class="note-meta__sep" aria-hidden="true">·</span>
        <span class="note-meta__category">{note.data.category}</span>
      </div>
    </header>

    <main id="main-content">
      <article class="note-article">

        <h1 class="note-title">{note.data.title}</h1>

        {note.data.description && (
          <p class="note-description">{note.data.description}</p>
        )}

        {note.data.tags && note.data.tags.length > 0 && (
          <ul class="note-tags" aria-label="Tags">
            {note.data.tags.map((tag) => (
              <li class="note-tag-item">#{tag}</li>
            ))}
          </ul>
        )}

        <div class="note-body">
          <Content />
        </div>

      </article>

      <footer class="note-footer">
        <a href="/#notes" class="back-link">← All notes</a>
      </footer>
    </main>

  </div>
</Base>

<style>
  .page {
    max-width: var(--bh-container-narrow);
    margin-inline: auto;
    padding: var(--bh-space-8) var(--bh-space-5) var(--bh-space-10);
  }

  /* ── Header ──────────────────────────────────────────────────────────── */

  .note-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--bh-space-9);
    padding-bottom: var(--bh-space-5);
    border-bottom: 1px solid var(--bh-border);
    animation: article-enter 350ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }

  .back-link {
    font-family: var(--bh-font-mono);
    font-size: var(--bh-text-xs);
    letter-spacing: var(--bh-tracking-mono);
    text-transform: uppercase;
    color: var(--bh-text-faint);
    border-bottom: none;
    transition: color var(--bh-duration-base) var(--bh-ease);
  }

  .back-link:hover { color: var(--bh-rust); }

  .note-meta {
    display: flex;
    gap: var(--bh-space-2);
    font-family: var(--bh-font-mono);
    font-size: var(--bh-text-xs);
    letter-spacing: var(--bh-tracking-mono);
    text-transform: uppercase;
    color: var(--bh-text-faint);
  }

  /* ── Article ─────────────────────────────────────────────────────────── */

  .note-article {
    animation: article-enter 450ms cubic-bezier(0.22, 0.61, 0.36, 1) 80ms both;
  }

  .note-title {
    font-family: var(--bh-font-display);
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    font-weight: 400;
    letter-spacing: var(--bh-tracking-tight);
    line-height: var(--bh-leading-snug);
    color: var(--bh-text);
    margin-bottom: var(--bh-space-5);
    text-wrap: balance;
  }

  .note-description {
    font-family: var(--bh-font-display);
    font-style: italic;
    font-size: var(--bh-text-md);
    color: var(--bh-text-muted);
    line-height: var(--bh-leading-snug);
    margin-bottom: var(--bh-space-5);
    text-wrap: pretty;
  }

  .note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--bh-space-2);
    list-style: none;
    margin-bottom: var(--bh-space-8);
    padding: 0;
  }

  .note-tag-item {
    font-family: var(--bh-font-mono);
    font-size: var(--bh-text-xs);
    letter-spacing: var(--bh-tracking-mono);
    color: var(--bh-text-faint);
  }

  /* ── Note body: prose ────────────────────────────────────────────────── */
  /*
   * Astro's scoped CSS cannot style elements rendered by <Content /> because
   * those elements don't receive the component's scoped data attribute.
   * All descendant selectors within .note-body must use :global().
   */

  .note-body {
    font-size: var(--bh-text-md);
    line-height: var(--bh-leading-normal);
    color: var(--bh-text-muted);
  }

  .note-body :global(p) {
    margin-bottom: var(--bh-space-5);
    text-wrap: pretty;
  }

  .note-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .note-body :global(h2) {
    font-family: var(--bh-font-display);
    font-size: var(--bh-text-xl);
    font-weight: 400;
    letter-spacing: var(--bh-tracking-tight);
    line-height: var(--bh-leading-snug);
    color: var(--bh-text);
    margin-top: var(--bh-space-8);
    margin-bottom: var(--bh-space-4);
    text-wrap: balance;
  }

  .note-body :global(h3) {
    font-family: var(--bh-font-sans);
    font-size: var(--bh-text-base);
    font-weight: 700;
    color: var(--bh-text);
    margin-top: var(--bh-space-6);
    margin-bottom: var(--bh-space-3);
    letter-spacing: -0.01em;
  }

  .note-body :global(ul),
  .note-body :global(ol) {
    margin-bottom: var(--bh-space-5);
    padding-left: var(--bh-space-6);
  }

  .note-body :global(li) {
    margin-bottom: var(--bh-space-2);
  }

  .note-body :global(li:last-child) {
    margin-bottom: 0;
  }

  .note-body :global(blockquote) {
    margin: var(--bh-space-6) 0;
    padding: var(--bh-space-4) var(--bh-space-5);
    background: var(--bh-bg-muted);
    border-radius: var(--bh-radius-sm);
    font-family: var(--bh-font-display);
    font-style: italic;
    font-size: var(--bh-text-md);
    color: var(--bh-text-muted);
  }

  .note-body :global(blockquote p) {
    margin-bottom: 0;
  }

  .note-body :global(code) {
    font-family: var(--bh-font-mono);
    font-size: 0.875em;
    background: var(--bh-bg-muted);
    color: var(--bh-text);
    padding: 0.1em 0.35em;
    border-radius: var(--bh-radius-sm);
  }

  .note-body :global(pre) {
    margin: var(--bh-space-6) 0;
    padding: var(--bh-space-5);
    background: var(--bh-bg-inverse);
    border-radius: var(--bh-radius-md);
    overflow-x: auto;
  }

  .note-body :global(pre code) {
    background: none;
    padding: 0;
    font-size: var(--bh-text-sm);
    color: var(--bh-text-inverse);
  }

  .note-body :global(hr) {
    border: none;
    border-top: 1px solid var(--bh-border);
    margin: var(--bh-space-8) 0;
  }

  .note-body :global(a) {
    color: var(--bh-text);
    border-bottom: 1px solid var(--bh-rust);
    transition: color var(--bh-duration-base) var(--bh-ease);
  }

  .note-body :global(a:hover) {
    color: var(--bh-rust);
  }

  .note-body :global(strong) {
    font-weight: 700;
    color: var(--bh-text);
  }

  .note-body :global(em) {
    font-style: italic;
  }

  /* ── Footer ──────────────────────────────────────────────────────────── */

  .note-footer {
    margin-top: var(--bh-space-9);
    padding-top: var(--bh-space-5);
    border-top: 1px solid var(--bh-border);
  }

  /* ── Entrance animations ─────────────────────────────────────────────── */

  @keyframes article-enter {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .note-header,
    .note-article { animation: none !important; }
  }
</style>
