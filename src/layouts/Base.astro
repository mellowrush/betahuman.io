---
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'betahuman.io',
  description = 'Exploring systems, tools and the search for meaningful work.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <ViewTransitions />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BR1GZH8LDP"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-BR1GZH8LDP');
    </script>

    <!-- Theme: apply before first paint to prevent FOUC.
         Also hooks astro:before-swap to carry the theme into every
         incoming page document before the View Transition swap. -->
    <script is:inline>
      function _bhApplyTheme() {
        const saved = localStorage.getItem('bh-theme');
        const sysDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute(
          'data-theme',
          saved || (sysDark ? 'dark' : 'light')
        );
      }

      _bhApplyTheme();

      // Copy the live theme to the incoming document before Astro swaps the DOM.
      // Without this, the new page briefly renders without data-theme set.
      document.addEventListener('astro:before-swap', function (ev) {
        const theme = document.documentElement.getAttribute('data-theme');
        if (theme) ev.newDocument.documentElement.setAttribute('data-theme', theme);
      });
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  /* ── Page transition choreography ─────────────────────────────────────── */

  /* Outgoing page: lifts up and fades */
  ::view-transition-old(root) {
    animation: vt-exit 180ms cubic-bezier(0.36, 0, 1, 1) both;
  }

  /* Incoming page: rises from slightly below */
  ::view-transition-new(root) {
    animation: vt-enter 360ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }

  /* Wordmark: same position on every page — pin it so it doesn't animate */
  ::view-transition-old(site-wordmark),
  ::view-transition-new(site-wordmark) {
    animation: none;
    mix-blend-mode: normal;
  }

  @keyframes vt-exit {
    to { opacity: 0; transform: translateY(-10px); }
  }

  @keyframes vt-enter {
    from { opacity: 0; transform: translateY(14px); }
  }

  /* Reduced motion: crossfade only, no movement */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root) {
      animation: vt-fade-out 100ms ease both;
    }
    ::view-transition-new(root) {
      animation: vt-fade-in 100ms ease both;
    }
    @keyframes vt-fade-out { to   { opacity: 0; } }
    @keyframes vt-fade-in  { from { opacity: 0; } }
  }
</style>
