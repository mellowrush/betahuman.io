---
interface Props {
  label: string;
  title: string;
  body: string;
}

const { label, title, body } = Astro.props;
---
<div class="now-card">
  <span class="now-card__label">{label}</span>
  <h3 class="now-card__title">{title}</h3>
  <p class="now-card__body">{body}</p>
</div>

<style>
  .now-card {
    background: var(--bh-bg-elevated);
    border: 1px solid var(--bh-border);
    padding: var(--bh-space-6);
  }

  .now-card__label {
    display: block;
    font-family: var(--bh-font-mono);
    font-size: var(--bh-text-xs);
    letter-spacing: var(--bh-tracking-mono);
    text-transform: uppercase;
    color: var(--bh-rust);
    margin-bottom: var(--bh-space-3);
  }

  .now-card__title {
    font-family: var(--bh-font-display);
    font-size: var(--bh-text-md);
    font-weight: 400;
    letter-spacing: var(--bh-tracking-tight);
    color: var(--bh-text);
    margin-bottom: var(--bh-space-3);
  }

  .now-card__body {
    font-size: var(--bh-text-sm);
    color: var(--bh-text-muted);
    line-height: var(--bh-leading-normal);
  }
</style>
