---
---
<header class="site-header" id="site-header">
  <a href="/" class="site-wordmark" aria-label="betahuman.io home" transition:name="site-wordmark">
    beta<span class="accent">human</span><span class="tld">.io</span>
  </a>

  <nav class="site-nav" id="site-nav" aria-label="Main navigation">
    <ul class="site-nav__list">
      <li><a href="#notes">Notes</a></li>
      <li><a href="#builds">Builds</a></li>
      <li><a href="#about">About</a></li>
    </ul>
  </nav>

  <div class="header-actions">
    <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" title="Toggle light/dark">
      <span class="theme-icon-wrap" aria-hidden="true">
        <!-- Sun: shown in dark mode (click to go light) -->
        <svg class="theme-icon theme-icon--sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <!-- Moon: shown in light mode (click to go dark) -->
        <svg class="theme-icon theme-icon--moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </span>
    </button>
    <button
      class="nav-toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open navigation menu"
    >
      <span class="nav-toggle__open">Menu</span>
      <span class="nav-toggle__close">Close</span>
    </button>
  </div>
</header>

<script>
  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('bh-theme', theme);
  }

  // AbortController cleans up listeners on every re-init (View Transitions re-fires
  // astro:page-load on each navigation, which would otherwise stack listeners).
  let controller = new AbortController();

  document.addEventListener('astro:page-load', () => {
    controller.abort();
    controller = new AbortController();
    const { signal } = controller;

    // ── Theme toggle ───────────────────────────────────────────────────────
    const themeBtn = document.getElementById('theme-toggle');
    themeBtn?.addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      applyTheme(isDark ? 'light' : 'dark');
    }, { signal });

    // ── Mobile nav ─────────────────────────────────────────────────────────
    const header  = document.getElementById('site-header') as HTMLElement | null;
    const navBtn  = document.getElementById('nav-toggle')  as HTMLButtonElement | null;

    function openNav() {
      header?.classList.add('is-open');
      navBtn?.setAttribute('aria-expanded', 'true');
      navBtn?.setAttribute('aria-label', 'Close navigation menu');
    }

    function closeNav() {
      header?.classList.remove('is-open');
      navBtn?.setAttribute('aria-expanded', 'false');
      navBtn?.setAttribute('aria-label', 'Open navigation menu');
    }

    navBtn?.addEventListener('click', () => {
      header?.classList.contains('is-open') ? closeNav() : openNav();
    }, { signal });

    document.querySelectorAll('#site-nav a').forEach((link) => {
      link.addEventListener('click', closeNav, { signal });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header?.classList.contains('is-open')) {
        closeNav();
        navBtn?.focus();
      }
    }, { signal });
  });
</script>

<style>
  /* ── BASE (desktop-first) ──────────────────────────────────────────────── */

  .site-header {
    display: flex;
    align-items: center;
    margin-bottom: var(--bh-space-9);
  }

  .site-wordmark {
    font-family: var(--bh-font-display);
    font-size: var(--bh-text-xl);
    letter-spacing: var(--bh-tracking-tight);
    color: var(--bh-text);
    border-bottom: none;
    flex-shrink: 0;
  }

  .site-wordmark:hover { color: var(--bh-text); }

  .accent { color: var(--bh-rust); }

  .tld {
    font-family: var(--bh-font-mono);
    font-size: var(--bh-text-xs);
    color: var(--bh-text-faint);
    letter-spacing: 0.05em;
  }

  .site-nav {
    margin-left: auto;
    margin-right: var(--bh-space-6);
  }

  .site-nav__list {
    display: flex;
    gap: var(--bh-space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__list a {
    font-family: var(--bh-font-mono);
    font-size: var(--bh-text-xs);
    letter-spacing: var(--bh-tracking-mono);
    text-transform: uppercase;
    color: var(--bh-text-muted);
    border-bottom: none;
    position: relative;
    transition: color var(--bh-duration-base) var(--bh-ease);
  }

  .site-nav__list a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--bh-rust);
    transition: width 220ms var(--bh-ease);
  }

  .site-nav__list a:hover { color: var(--bh-rust); }
  .site-nav__list a:hover::after { width: 100%; }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--bh-space-3);
    flex-shrink: 0;
  }

  /* ── Theme toggle ──────────────────────────────────────────────────────── */

  .theme-toggle {
    background: none;
    border: 1px solid var(--bh-border-strong);
    border-radius: var(--bh-radius-sm);
    padding: 5px;
    cursor: pointer;
    color: var(--bh-text-muted);
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--bh-duration-base) var(--bh-ease),
                color var(--bh-duration-base) var(--bh-ease);
  }

  .theme-toggle:hover {
    border-color: var(--bh-rust);
    color: var(--bh-rust);
  }

  .theme-toggle:focus-visible {
    outline: none;
    box-shadow: var(--bh-shadow-focus);
  }

  /* Grid overlay: both icons share the same cell and crossfade */
  .theme-icon-wrap {
    display: grid;
    place-items: center;
    width: 15px;
    height: 15px;
  }

  .theme-icon {
    grid-area: 1 / 1;
    transition: opacity 220ms var(--bh-ease), transform 220ms var(--bh-ease);
  }

  /* Light mode: moon visible, sun hidden */
  .theme-icon--sun  { opacity: 0; transform: scale(0.6) rotate(-45deg); }
  .theme-icon--moon { opacity: 1; transform: scale(1)   rotate(0deg);   }

  /* Dark mode: sun visible, moon hidden */
  :global([data-theme="dark"]) .theme-icon--sun  { opacity: 1; transform: scale(1)   rotate(0deg);  }
  :global([data-theme="dark"]) .theme-icon--moon { opacity: 0; transform: scale(0.6) rotate(45deg); }

  /* Nav toggle — hidden on desktop */
  .nav-toggle { display: none; }

  /* ── MOBILE (≤ 480px) ──────────────────────────────────────────────────── */

  @media (max-width: 480px) {
    .site-header {
      flex-wrap: wrap;
      align-items: center;
      margin-bottom: var(--bh-space-7);
    }

    .header-actions { margin-left: auto; }

    .site-nav {
      display: none;
      order: 10;
      width: 100%;
      margin: 0;
      margin-top: var(--bh-space-4);
      padding-top: var(--bh-space-4);
      border-top: 1px solid var(--bh-border);
    }

    .site-header.is-open .site-nav { display: block; }

    @media (prefers-reduced-motion: no-preference) {
      .site-header.is-open .site-nav {
        animation: nav-reveal var(--bh-duration-base) var(--bh-ease) both;
      }
    }

    .site-nav__list { flex-direction: column; gap: 0; }

    .site-nav__list li { border-bottom: 1px solid var(--bh-border); }
    .site-nav__list li:last-child { border-bottom: none; }

    .site-nav__list a {
      display: flex;
      align-items: center;
      min-height: 52px;
      padding: var(--bh-space-3) 0;
      font-family: var(--bh-font-display);
      font-size: var(--bh-text-xl);
      letter-spacing: var(--bh-tracking-tight);
      text-transform: none;
      color: var(--bh-text);
    }

    .site-nav__list a::after { display: none; }
    .site-nav__list a:hover { color: var(--bh-rust); }

    .nav-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      background: none;
      border: 1px solid var(--bh-border-strong);
      border-radius: var(--bh-radius-sm);
      padding: var(--bh-space-1) var(--bh-space-3);
      cursor: pointer;
      font-family: var(--bh-font-mono);
      font-size: var(--bh-text-xs);
      letter-spacing: var(--bh-tracking-mono);
      text-transform: uppercase;
      color: var(--bh-text-faint);
      min-height: 30px;
      min-width: 52px;
      transition: border-color var(--bh-duration-base) var(--bh-ease),
                  color var(--bh-duration-base) var(--bh-ease);
    }

    .nav-toggle:hover { border-color: var(--bh-rust); color: var(--bh-rust); }
    .nav-toggle:focus-visible { outline: none; box-shadow: var(--bh-shadow-focus); }

    .nav-toggle__open  { display: block; }
    .nav-toggle__close { display: none;  }

    .site-header.is-open .nav-toggle__open  { display: none;  }
    .site-header.is-open .nav-toggle__close { display: block; }
  }

  /* ── ANIMATIONS ────────────────────────────────────────────────────────── */

  @keyframes nav-reveal {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>
