---
interface Props {
  title: string;
  date: string;
  category: string;
  slug: string;
}

const { title, date, category, slug } = Astro.props;
---
<article class="note-card">
  <div class="note-card__meta">
    <span class="note-card__date">{date}</span>
    <span class="note-card__category">{category}</span>
  </div>
  <div class="note-card__content">
    <a href={`/notes/${slug}`} class="note-card__title">{title}</a>
  </div>
</article>

<style>
  .note-card {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: var(--bh-space-5);
    padding: var(--bh-space-5) 0;
    border-bottom: 1px solid var(--bh-border);
  }

  .note-card:last-child {
    border-bottom: none;
  }

  .note-card__meta {
    display: flex;
    flex-direction: column;
    gap: var(--bh-space-1);
    padding-top: 2px;
  }

  .note-card__date,
  .note-card__category {
    font-family: var(--bh-font-mono);
    font-size: var(--bh-text-xs);
    letter-spacing: var(--bh-tracking-mono);
    text-transform: uppercase;
    color: var(--bh-text-faint);
  }

  .note-card__title {
    font-family: var(--bh-font-display);
    font-size: var(--bh-text-lg);
    font-weight: 400;
    letter-spacing: var(--bh-tracking-tight);
    line-height: var(--bh-leading-snug);
    border-bottom: none;
    color: var(--bh-text);
    transition: color var(--bh-duration-base) var(--bh-ease);
  }

  .note-card__title:hover {
    color: var(--bh-rust);
  }

  @media (max-width: 540px) {
    .note-card {
      grid-template-columns: 1fr;
      gap: var(--bh-space-2);
    }

    .note-card__meta {
      flex-direction: row;
      gap: var(--bh-space-4);
    }
  }
</style>
